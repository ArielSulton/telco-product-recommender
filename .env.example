# ==============================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================
# Copy this file to .env for development or .env.production for production
# Update all placeholder values before deployment!

# Environment
NODE_ENV=development
PYTHON_ENV=development
ENVIRONMENT=development

# ==============================================
# BACKEND CONFIGURATION
# ==============================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
PROJECT_NAME=Paketify - Smart Telco Recommender
VERSION=1.0.0
API_V1_STR=/api/v1

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=telco_recommender
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@postgres:5432/telco_recommender

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:your_redis_password_here@redis:6379/0
REDIS_CACHE_TTL=3600

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=telco_recommender
MLFLOW_REGISTRY_URI=http://mlflow:5000

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# JWT Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================

# API URL
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=Paketify
VITE_APP_VERSION=1.0.0

# ==============================================
# INFRASTRUCTURE CONFIGURATION
# ==============================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
GRAFANA_SECRET_KEY=your_grafana_secret_here

# Airflow (Generate AIRFLOW_FERNET_KEY with:)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_HOME=/opt/airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_airflow_secret_here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_password_here
AIRFLOW_ADMIN_EMAIL=admin@yourdomain.com

# ==============================================
# PRODUCTION DOMAINS (for production only)
# ==============================================

FRONTEND_DOMAIN=yourdomain.com
BACKEND_DOMAIN=api.yourdomain.com
MONITORING_DOMAIN=grafana.yourdomain.com
MLFLOW_DOMAIN=mlflow.yourdomain.com
PROMETHEUS_DOMAIN=prom.yourdomain.com
AIRFLOW_DOMAIN=airflow.yourdomain.com
TRAEFIK_ACME_EMAIL=admin@yourdomain.com

# ==============================================
# LOGGING
# ==============================================

LOG_LEVEL=INFO
LOG_FORMAT=json
