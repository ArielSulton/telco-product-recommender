# ==============================================
# ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control!

# Environment
NODE_ENV=development
PYTHON_ENV=development
ENVIRONMENT=development

# ==============================================
# BACKEND CONFIGURATION
# ==============================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
PROJECT_NAME=Telco Product Recommender
VERSION=1.0.0
API_V1_STR=/api/v1

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=telco_recommender
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/telco_recommender

# Database Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=telco_recommender
MLFLOW_REGISTRY_URI=http://localhost:5000
MODEL_VERSION=latest
MODEL_REGISTRY_PATH=models/

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# JWT Authentication
# IMPORTANT: Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_this_in_production_with_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_RECOMMENDATIONS=50
RATE_LIMIT_EVENTS=200

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================

# API URL
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=Telco Product Recommender
VITE_APP_VERSION=1.0.0

# ==============================================
# ML PIPELINE CONFIGURATION
# ==============================================

# Model Configuration
FEATURE_STORE_PATH=data/features/
FEATURE_CACHE_ENABLED=true
FEATURE_CACHE_KEY_PREFIX=user_features:

# Training Configuration
BATCH_SIZE=1024
LEARNING_RATE=0.001
N_CLUSTERS=5
N_EPOCHS=10

# Recommendation Configuration
TOP_K_CANDIDATES=50
TOP_N_RECOMMENDATIONS=5
DIVERSITY_THRESHOLD=0.7

# ==============================================
# DATA SIMULATOR CONFIGURATION
# ==============================================

# Data Source
DATA_SOURCE_PATH=ml/data/raw/ac-01_telco_customer_behavior_mock_data.csv

# Ingestion Settings
BATCH_SIZE=1000
INGESTION_INTERVAL_HOURS=4
START_IMMEDIATELY=true
REPLAY_MODE=false
USE_CRON=false

# Simulator Behavior
# BATCH_SIZE: Number of rows to process per batch (default: 1000)
# INGESTION_INTERVAL_HOURS: Hours between ingestion runs (default: 4)
# START_IMMEDIATELY: Start ingestion on service startup (default: true)
# REPLAY_MODE: Reset and replay from beginning (default: false)
# USE_CRON: Use cron schedule instead of interval (default: false)

# ==============================================
# INFRASTRUCTURE CONFIGURATION
# ==============================================

# Docker Compose
COMPOSE_PROJECT_NAME=telco-recommender

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SECRET_KEY=

# Airflow
# Generate AIRFLOW_FERNET_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_HOME=/opt/airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ==============================================
# PRODUCTION DEPLOYMENT CONFIGURATION
# ==============================================

# Domain Configuration
FRONTEND_DOMAIN=app.telco-recommender.com
BACKEND_DOMAIN=api.telco-recommender.com
MONITORING_DOMAIN=monitoring.telco-recommender.com

# SSL Configuration
TRAEFIK_ACME_EMAIL=admin@telco-recommender.com

# Build Configuration
BUILD_DATE=
VCS_REF=

# Resource Limits (Production)
BACKEND_MEMORY_LIMIT=2G
BACKEND_CPU_LIMIT=2
FRONTEND_MEMORY_LIMIT=1G
FRONTEND_CPU_LIMIT=1
DATABASE_MEMORY_LIMIT=2G
DATABASE_CPU_LIMIT=2
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_LIMIT=1

# S3/Object Storage (Optional)
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==============================================
# LOGGING & MONITORING
# ==============================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (Optional - for error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ==============================================
# TESTING CONFIGURATION
# ==============================================

# Test Database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test_password@localhost:5432/telco_recommender_test
TESTING=false

# Test Configuration
PYTEST_WORKERS=4
COVERAGE_THRESHOLD=80
