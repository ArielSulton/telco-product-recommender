# ==============================================
# SHOWCASE ENVIRONMENT CONFIGURATION
# ==============================================
# Used with compose.showcase.yaml (postgres + redis + backend + frontend only)
# Copy the values you need into Dokploy's Environment panel for this app.
# DO NOT commit a filled-in copy of this file to version control!

NODE_ENV=production
PYTHON_ENV=production
ENVIRONMENT=production

# ==============================================
# BACKEND CONFIGURATION
# ==============================================
API_V1_STR=/api/v1
PROJECT_NAME=Paketify - Smart Telco Recommender
VERSION=1.0.0

# Database — DATABASE_HOST/DATABASE_URL host must be "telco-postgres"
# (matches the service name in compose.showcase.yaml)
DATABASE_HOST=telco-postgres
DATABASE_PORT=5432
DATABASE_NAME=telco_recommender
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@telco-postgres:5432/telco_recommender

# Redis — host must be "telco-redis"
REDIS_HOST=telco-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME@telco-redis:6379/0

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME

# CORS — adjust to your actual domain
ALLOWED_ORIGINS=https://your-domain.example

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
VITE_API_URL=/api/v1
VITE_APP_NAME=Paketify
VITE_APP_VERSION=1.0.0

# ==============================================
# DOMAIN (Traefik routing — reused for both frontend and backend labels)
# ==============================================
FRONTEND_DOMAIN=your-domain.example

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================
# BUILD METADATA (optional)
# ==============================================
BUILD_DATE=
VCS_REF=
