{
  "title": "Telco Recommender System Overview",
  "uid": "recommender-system",
  "schemaVersion": 16,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Recommendations Served",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(recommendation_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Users (Last Hour)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(count_over_time(events_total{event_type='view'}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Recommendation Click-Through Rate",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(events_total{event_type='click'}[5m]) / rate(events_total{event_type='view'}[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "System Health Status",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job='backend'}",
          "refId": "A"
        }
      ],
      "mappings": [
        {"value": 1, "text": "Healthy", "color": "green"},
        {"value": 0, "text": "Down", "color": "red"}
      ]
    }
  ]
}
